{
  "name": "sysl",
  "displayName": "SysL",
  "description": "Language server client and syntax highlighting for sysl",
  "version": "0.1.1",
  "publisher": "sysl-lang",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/sysl-lang/vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:sysl"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "sysl",
        "aliases": [
          "SysL",
          "sysl"
        ],
        "extensions": [
          ".sysl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sysl",
        "scopeName": "source.sysl",
        "path": "./syntaxes/sysl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "SysL",
      "properties": {
        "sysl.server.path": {
          "type": "string",
          "default": "sysl",
          "description": "The sysl executable. The extension runs it as '<path> lsp --stdio'."
        },
        "sysl.lib": {
          "type": "string",
          "default": "",
          "description": "The standard library root, passed to the server as SYSL_LIB. Empty leaves the environment as it is, which is what an installed sysl wants."
        },
        "sysl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages exchanged with the language server in the SysL output channel."
        }
      }
    },
    "commands": [
      {
        "command": "sysl.restartServer",
        "title": "SysL: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.cjs --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vscode-jsonrpc": "9.0.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "type": "module"
}
